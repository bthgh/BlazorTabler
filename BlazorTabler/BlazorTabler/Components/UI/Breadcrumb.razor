@inherits TablerComponentBase
@namespace BlazorTabler.UI

<ol @ref="@Element" id="@Id" class="@Classes" style="@CssStyle" @attributes="@AdditionalAttributes" aria-label="breadcrumbs">
    @for (var i = 0; i < BreadcrumbPages.Count; i++)
    {
        var isLast = i == BreadcrumbPages.Count - 1;
        var isFirst = i == 0;

        if (isLast)
        {
            <li class="breadcrumb-item active" aria-current="page">
                <a href="#">@BreadcrumbPages[i]</a>
            </li>
        }
        else
        {
            <li class="breadcrumb-item">
                @if (isFirst && HomeIcon)
                {
                    <a href="/">
                        <SvgIcon Icon="TablerSvgIcons.home" />
                    </a>
                }
                else
                {
                    <a href="#">@BreadcrumbPages[i]</a>
                }
            </li>
        }
    }
</ol>



@code {
    [Parameter] public string Pages { get; set; } = "Home,Library,Data";
    [Parameter] public string? Separator { get; set; }
    [Parameter] public bool HomeIcon { get; set; }
 

    private IReadOnlyList<string> BreadcrumbPages =>
        Pages.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    
    private string Classes =>
        string.Join(" ",
                "breadcrumb",
                !string.IsNullOrWhiteSpace(Separator) ? $"breadcrumb-{Separator}" : null,
                CssClass
            )
            .Trim();
}