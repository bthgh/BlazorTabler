@using BlazorTabler.Data
@inherits TablerComponentBase
@namespace BlazorTabler.Parts



<div class="divide-y">
    @for (var index = 0; index < _activities.Count; index++)
    {
        var activity = _activities[index];
        {% assign person = people[forloop.index] %
        }
        <div>
            <div class="row">
                <div class="col-auto">
                    {% include "ui/avatar.html" person=person %}
                </div>
                <div class="col">
                    <div class="text-truncate">
                        {{ item.text | replace: '%p', person.full_name | replace: '%c', person.company }}
                    </div>
                    <div class="text-secondary">{{ forloop.index | random_date_ago: 4 | timeago }}</div>
                </div>
                {% if forloop.index < 5 %}
                <div class="col-auto align-self-center">
                    <div class="badge bg-primary"></div>
                </div>
                {% endif %}
            </div>
            @:
        </div>
    }
</div>

@code {
    [Parameter] public bool Limit { get; set; } 
    
    private List<dynamic> _activities;
    private List<dynamic> _people;
    

    protected override async Task OnInitializedAsync()
    {
        _activities = Repository.GetActivity();
        _people = Repository.GetPeople();
    }
}