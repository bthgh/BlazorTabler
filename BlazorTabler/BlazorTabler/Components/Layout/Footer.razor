@inherits TablerComponentBase
@namespace BlazorTabler.Layout
@inject IOptions<AppSettings> Settings

<!--  BEGIN FOOTER  -->
<footer class="footer footer-transparent d-print-none">
    <div class="container-xl">
        <div class="row text-center align-items-center flex-row-reverse">
            <div class="col-lg-auto ms-lg-auto">
                <ul class="list-inline list-inline-dots mb-0">
                    <li class="list-inline-item"><a href="@Settings.Value.DocsUrl" target="_blank" class="link-secondary" rel="noopener">Documentation</a></li>
                    <li class="list-inline-item"><a href="@Settings.Value.LicenseUrl" class="link-secondary">License</a></li>
                    <li class="list-inline-item"><a href="@Settings.Value.GithubUrl" target="_blank" class="link-secondary" rel="noopener">Source code</a></li>
                    <li class="list-inline-item">
                        <a href="@Settings.Value.GithubSponsorsUrl" target="_blank" class="link-secondary" rel="noopener">
                            <SvgIcon Icon="@TablerSvgIcons.heart" Inline="true" Filled="true" Color="pink" />
                            Sponsor
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                <ul class="list-inline list-inline-dots mb-0">
                    <li class="list-inline-item">
                        Copyright &copy; @DateTime.Now.Year
                        <a href="/" class="link-secondary">@Settings.Value.AppTitle</a>.
                        All rights reserved.
                    </li>
                    <li class="list-inline-item">
                        <a href="/changelog.html" class="link-secondary" rel="noopener">
                            v1.4.0
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</footer>
<!--  END FOOTER  -->


